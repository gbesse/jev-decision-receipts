{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jev.dev/schemas/decision-receipt/v1",
  "title": "Jev Decision Receipt v1",
  "type": "object",
  "required": ["$schema", "version", "id", "createdAt", "subject", "revision", "producer", "candidates", "criteria", "evaluations", "verdict", "provenance", "integrity"],
  "properties": {
    "$schema": { "const": "https://jev.dev/schemas/decision-receipt/v1" },
    "version": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^jvr_[a-f0-9]{20}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "subject": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "producer": { "type": "object", "required": ["name", "version"] },
    "candidates": { "type": "array", "minItems": 2, "maxItems": 32 },
    "criteria": { "type": "array", "minItems": 1, "maxItems": 32 },
    "evaluations": { "type": "array" },
    "verdict": { "type": "object", "required": ["status", "ranking", "reasons"] },
    "provenance": { "type": "object", "required": ["method", "generatedBy"] },
    "integrity": { "type": "object", "required": ["algorithm", "digest"], "properties": { "algorithm": { "const": "sha256" }, "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
  },
  "additionalProperties": true
}
